{
  "name": "@mdaemon/validate",
  "version": "4.0.1",
  "type": "module",
  "description": "A validation library used by MDaemon Remote Administration",
  "main": "dist/validate.umd.js",
  "module": "dist/validate.mjs",
  "browser": "dist/validate.umd.js",
  "common": "dist/validate.cjs",
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run typecheck:build && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "watch": "vitest",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit",
    "test:smoke": "node smoke/smoke.test.cjs && node smoke/smoke.test.mjs && node smoke/smoke.test.umd.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaemon-technologies/validate.git"
  },
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "LGPL-2.1",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/validate/issues"
  },
  "homepage": "https://github.com/mdaemon-technologies/validate#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "^6.0.2",
    "rollup": "^4.40.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/validate.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/validate.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/validate.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "validation",
    "schema",
    "domains",
    "passwords",
    "ldap",
    "headers",
    "email",
    "ipv4",
    "ipv6",
    "windows files",
    "windows paths"
  ]
}
