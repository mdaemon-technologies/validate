{
  "name": "@mdaemon/validate",
  "version": "3.5.1",
  "type": "module",
  "description": "A validation library used by MDaemon Remote Administration",
  "main": "dist/validate.umd.js",
  "module": "dist/validate.mjs",
  "browser": "dist/validate.umd.js",
  "common": "dist/validate.cjs",
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "watch": "jest --watchAll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaemon-technologies/validate.git"
  },
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "LGPL-2.1",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/validate/issues"
  },
  "homepage": "https://github.com/mdaemon-technologies/validate#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "rollup": "^4.40.0",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/validate.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/validate.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/validate.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "validation",
    "schema",
    "domains",
    "passwords",
    "ldap",
    "headers",
    "email",
    "ipv4",
    "ipv6",
    "windows files",
    "windows paths"
  ]
}
